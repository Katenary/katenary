apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  annotations:
    katenary.io/compose-hash: 2dbbb5196e83bf961fdaabeab66ee5b3a2713a40
    katenary.io/version: master
  labels:
    {{- include "cronjob.labels" . | nindent 4 }}
    app.kubernetes.io/component: cron
  name: '{{ include "cronjob.fullname" . }}-cron'
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: '{{ include "cronjob.fullname" . }}-cron'
subjects:
- kind: ServiceAccount
  name: '{{ include "cronjob.fullname" . }}-cron'
  namespace: '{{ .Release.Namespace }}'

