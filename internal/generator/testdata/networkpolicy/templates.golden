apiVersion: v1
kind: ServiceAccount
metadata:
  annotations:
    katenary.io/compose-hash: f89a31b1e299ddd1e0d2036428c549b3c5350719
    katenary.io/version: master
  labels:
    {{- include "networkpolicy.labels" . | nindent 4 }}
    app.kubernetes.io/component: web
  name: '{{ include "networkpolicy.fullname" . }}-web-dependency'
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  annotations:
    katenary.io/compose-hash: f89a31b1e299ddd1e0d2036428c549b3c5350719
    katenary.io/version: master
  labels:
    {{- include "networkpolicy.labels" . | nindent 4 }}
    app.kubernetes.io/component: web
  name: '{{ include "networkpolicy.fullname" . }}-web-dependency'
rules:
- apiGroups:
