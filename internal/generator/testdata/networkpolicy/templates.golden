# Source: templates/web/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    katenary.io/compose-hash: f89a31b1e299ddd1e0d2036428c549b3c5350719
    katenary.io/version: master
  labels:
    {{- include "networkpolicy.labels" . | nindent 4 }}
    app.kubernetes.io/component: web
  name: '{{ include "networkpolicy.fullname" . }}-web'
spec:
  replicas: {{ .Values.web.replicas }}
  selector:
    matchLabels:
      {{- include "networkpolicy.selectorLabels" . | nindent 6 }}
      app.kubernetes.io/component: web
  strategy: {}
  template:
    metadata:
      labels:
        {{- include "networkpolicy.selectorLabels" . | nindent 8 }}
        app.kubernetes.io/component: web
    spec:
      containers:
      - image: '{{ tpl .Values.web.repository.image $ }}:{{ tpl .Values.web.repository.tag $ | default "latest" }}'
        imagePullPolicy: {{ .Values.web.imagePullPolicy }}
        name: web
        ports:
        - containerPort: 80
          name: http
        {{- if .Values.web.resources }}
        resources:
          {{ .Values.web.resources | toYaml | nindent 10 }}
        {{- end }}
        securityContext:
          allowPrivilegeEscalation: false
      {{- if .Values.pullSecrets }}
      imagePullSecrets:
      {{- .Values.pullSecrets | toYaml | nindent 6 }}
      {{- end }}
      initContainers:
      - command:
        - /bin/sh
        - -c
        - |-
          NAMESPACE=${NAMESPACE:-default}
          DEPLOYMENT_NAME={{ include "networkpolicy.fullname" . }}-database
          KUBERNETES_SERVICE_HOST=${KUBERNETES_SERVICE_HOST:-kubernetes.default.svc}
          KUBERNETES_SERVICE_PORT=${KUBERNETES_SERVICE_PORT:-443}

          until curl -s -o- --header="Authorization: Bearer $(cat /var/run/secrets/kubernetes.io/serviceaccount/token)" \
            --cacert=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt \
            "https://${KUBERNETES_SERVICE_HOST}:${KUBERNETES_SERVICE_PORT}/apis/apps/v1/namespaces/${NAMESPACE}/deployments/${DEPLOYMENT_NAME}" \
            | grep -q '"readyReplicas":[[:space:]]*[1-9][0-9]*'; do
            sleep 2
          done
        env:
        - name: NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        image: quay.io/curl/curl:8.23.0
        name: wait-for-database
        {{- if .Values.web.resources }}
        resources:
          {{ .Values.web.resources | toYaml | nindent 10 }}
        {{- end }}
      {{- if .Values.web.nodeSelector }}
      nodeSelector:
        {{- .Values.web.nodeSelector | toYaml | nindent 8 }}
      {{- end }}
      serviceAccountName: '{{ include "networkpolicy.fullname" . }}-web-dependency'

# Source: templates/web/ingress.yaml
{{- if .Values.web.ingress.enabled -}}
{{- $fullname := include "networkpolicy.fullname" . -}}
{{- $tlsname := printf "%s-%s-tls" $fullname "web" -}}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  annotations:
    katenary.io/compose-hash: f89a31b1e299ddd1e0d2036428c549b3c5350719
    katenary.io/version: master
  {{- if .Values.web.ingress.annotations -}}
      {{- toYaml .Values.web.ingress.annotations | nindent 6 }}
      {{- end }}
  labels:
    {{- include "networkpolicy.labels" . | nindent 4 }}
    app.kubernetes.io/component: web
  name: '{{ $fullname }}-web'
spec:
  {{- if ne .Values.web.ingress.class "-" }}
  ingressClassName: '{{ tpl .Values.web.ingress.class $ }}'
  {{- end }}
  rules:
  - host: '{{ tpl .Values.web.ingress.host $ }}'
    http:
      paths:
      - backend:
          service:
            name: '{{ $fullname }}-web'
            port:
              name: http
        path: '{{ tpl .Values.web.ingress.path $ }}'
        pathType: ImplementationSpecific
  {{- if .Values.web.ingress.tls.enabled }}
  tls:
  - hosts:
    - '{{ tpl .Values.web.ingress.host . }}'
    secretName: '{{ .Values.web.ingress.tls.secretName | default $tlsname }}'
  {{ end -}}

{{- end -}}
# Source: templates/web/ingressroute.yaml
{{- if .Values.web.ingress.ingressRouteEnabled -}}
{{- $fullname := include "networkpolicy.fullname" . -}}
{{- $tlsname := printf "%s-%s-tls" $fullname "web" -}}
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  annotations:
    katenary.io/compose-hash: f89a31b1e299ddd1e0d2036428c549b3c5350719
    katenary.io/version: master
  {{- if .Values.web.ingress.annotations -}}
      {{- toYaml .Values.web.ingress.annotations | nindent 6 }}
      {{- end }}
  labels:
    {{- include "networkpolicy.labels" . | nindent 4 }}
    app.kubernetes.io/component: web
  name: '{{ $fullname }}-web'
spec:
  entryPoints:
  - web
  - websecure
  routes:
  - kind: Rule
    match: Host("{{ tpl .Values.web.ingress.host . }}") && PathPrefix("{{ tpl .Values.web.ingress.path $ }}")
    services:
    - name: '{{ $fullname }}-web'
      port: 80
  tls:
    domains:
    - main: '{{ tpl .Values.web.ingress.host . }}'
    secretName: '{{ .Values.web.ingress.tls.secretName | default $tlsname }}'

{{- end -}}
