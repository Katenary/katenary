{{- if .Values.database.networkPolicy.enabled -}}
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  annotations:
    katenary.io/compose-hash: f89a31b1e299ddd1e0d2036428c549b3c5350719
    katenary.io/version: master
  labels:
    {{- include "networkpolicy.labels" . | nindent 4 }}
    app.kubernetes.io/component: database
  name: '{{ include "networkpolicy.fullname" . }}-database'
spec:
  egress:
  - ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
    to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
  - to:
    - podSelector:
        matchLabels:
          {{- include "networkpolicy.selectorLabels" . | nindent 10 }}
  - ports:
    - port: 443
      protocol: TCP
    - port: 6443
      protocol: TCP
    to:
    - ipBlock:
        cidr: 0.0.0.0/0
    - ipBlock:
        cidr: ::/0
  ingress:
  - from:
    - podSelector:
        matchLabels:
          {{- include "networkpolicy.selectorLabels" . | nindent 10 }}
    ports:
    - port: 5432
      protocol: TCP
  podSelector:
    matchLabels:
      {{- include "networkpolicy.selectorLabels" . | nindent 6 }}
      app.kubernetes.io/component: database
  policyTypes:
  - Ingress
  - Egress

{{- end -}}

