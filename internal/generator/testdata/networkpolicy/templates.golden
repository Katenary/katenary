# Source: templates/NOTES.txt
Thanks to have installed {{ .Chart.Name }} {{ .Chart.Version }} as {{ .Release.Name }} ({{.Chart.AppVersion }}).

# Get release information

To learn more about the release, try:

  $ helm -n {{ .Release.Namespace }} status {{ .Release.Name }}
  $ helm -n {{ .Release.Namespace }} get values {{ .Release.Name }}
  $ helm -n {{ .Release.Namespace }} get all {{ .Release.Name }}

# To delete the release

Use helm uninstall command to delete the release. 

  $ helm -n {{ .Release.Namespace }} uninstall {{ .Release.Name }}

Note that some resources may still be in use after a release is deleted. For exemple, PersistentVolumeClaims are not deleted by default for some storage classes or if some annotations are set.

# More information

You can see this notes again by running:

  $ helm -n {{ .Release.Namespace }} get notes {{ .Release.Name }}

{{- $count := 0 -}}
{{- $listOfURL := "" -}}
{{- if and .Values.database.ingress .Values.database.ingress.enabled }}
{{- $count = add1 $count -}}{{- $listOfURL = printf "%s\n- http://%s" $listOfURL (tpl .Values.database.ingress.host .) -}}
{{- end }}
{{- if and .Values.web.ingress .Values.web.ingress.enabled }}
{{- $count = add1 $count -}}{{- $listOfURL = printf "%s\n- http://%s" $listOfURL (tpl .Values.web.ingress.host .) -}}
{{- end }}
{{- if gt $count 0 }}

# List of activated ingresses URL:
{{ $listOfURL }}

You can get these urls with kubectl:

    kubeclt get ingress -n {{ .Release.Namespace }}

{{- end }}

Thanks for using Helm!

# Source: templates/_helpers.tpl
{{- define "networkpolicy.fullname" -}}
{{- if .Values.fullnameOverride -}}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- $name := default .Chart.Name .Values.nameOverride -}}
{{- if contains $name .Release.Name -}}
{{- .Release.Name | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{- define "networkpolicy.name" -}}
{{- if .Values.nameOverride -}}
{{- .Values.nameOverride | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" -}}
{{- end -}}
{{- end -}}

{{- define "networkpolicy.labels" -}}
{{ include "networkpolicy.selectorLabels" .}}
{{- if .Chart.Version }}
{{ printf "helm.sh/chart: %s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
{{- end }}
{{- if .Chart.AppVersion }}
{{ printf "app.kubernetes.io/version: '%s'" .Chart.AppVersion }}
{{- end }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
{{- end -}}

{{- define "networkpolicy.selectorLabels" -}}
{{- $name := default .Chart.Name .Values.nameOverride -}}
{{ printf "app.kubernetes.io/name: %s" $name }}
{{ printf "app.kubernetes.io/instance: %s" .Release.Name }}
{{- end -}}

# Source: templates/database/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    katenary.io/compose-hash: f89a31b1e299ddd1e0d2036428c549b3c5350719
    katenary.io/version: master
  labels:
    {{- include "networkpolicy.labels" . | nindent 4 }}
    app.kubernetes.io/component: database
  name: '{{ include "networkpolicy.fullname" . }}-database'
spec:
  replicas: {{ .Values.database.replicas }}
  selector:
    matchLabels:
      {{- include "networkpolicy.selectorLabels" . | nindent 6 }}
      app.kubernetes.io/component: database
  strategy: {}
  template:
    metadata:
      labels:
        {{- include "networkpolicy.selectorLabels" . | nindent 8 }}
        app.kubernetes.io/component: database
    spec:
      containers:
      - image: '{{ tpl .Values.database.repository.image $ }}:{{ tpl .Values.database.repository.tag $ | default "latest" }}'
        imagePullPolicy: {{ .Values.database.imagePullPolicy }}
        name: database
        ports:
        - containerPort: 5432
          name: postgresql
        {{- if .Values.database.resources }}
        resources:
          {{ .Values.database.resources | toYaml | nindent 10 }}
        {{- end }}
        securityContext:
          allowPrivilegeEscalation: false
      {{- if .Values.pullSecrets }}
      imagePullSecrets:
      {{- .Values.pullSecrets | toYaml | nindent 6 }}
      {{- end }}
      {{- if .Values.database.nodeSelector }}
      nodeSelector:
        {{- .Values.database.nodeSelector | toYaml | nindent 8 }}
      {{- end }}
      {{- if ne .Values.database.serviceAccount "" }}
      serviceAccountName: {{ .Values.database.serviceAccount | quote }}
      {{- end }}

