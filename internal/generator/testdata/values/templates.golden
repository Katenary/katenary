# Source: templates/web/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    katenary.io/compose-hash: 88a5d466b9b52d55fe3dc096e0d148c3ec6959c0
    katenary.io/version: master
  labels:
    {{- include "values.labels" . | nindent 4 }}
    app.kubernetes.io/component: web
  name: '{{ include "values.fullname" . }}-web'
spec:
  replicas: {{ .Values.web.replicas }}
  selector:
    matchLabels:
      {{- include "values.selectorLabels" . | nindent 6 }}
      app.kubernetes.io/component: web
  strategy: {}
  template:
    metadata:
      labels:
        {{- include "values.selectorLabels" . | nindent 8 }}
        app.kubernetes.io/component: web
    spec:
      containers:
      - envFrom:
        - configMapRef:
            name: '{{ include "values.fullname" . }}-web'
        image: '{{ tpl .Values.web.repository.image $ }}:{{ tpl .Values.web.repository.tag $ | default "latest" }}'
        imagePullPolicy: {{ .Values.web.imagePullPolicy }}
        name: web
        {{- if .Values.web.resources }}
        resources:
          {{ .Values.web.resources | toYaml | nindent 10 }}
        {{- end }}
        securityContext:
          allowPrivilegeEscalation: false
      {{- if .Values.pullSecrets }}
      imagePullSecrets:
      {{- .Values.pullSecrets | toYaml | nindent 6 }}
      {{- end }}
      {{- if .Values.web.nodeSelector }}
      nodeSelector:
        {{- .Values.web.nodeSelector | toYaml | nindent 8 }}
      {{- end }}
      {{- if ne .Values.web.serviceAccount "" }}
      serviceAccountName: {{ .Values.web.serviceAccount | quote }}
      {{- end }}

